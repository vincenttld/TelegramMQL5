           <!-- Description -->
           <item>
            <widget class="QLabel" name="labelFolderDescription">
             <property name="text">
              <string>Select your MetaTrader 5 Terminal folder (the folder named with your terminal ID, under MetaQuotes\Terminal) to enable automatic communication with your Expert Advisors.
Example: C:\Users\&lt;user&gt;\AppData\Roaming\MetaQuotes\Terminal\&lt;TERMINAL_ID&gt;</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="alignment">
              <set>Qt::AlignmentFlag::AlignCenter</set>
             </property>
            </widget>
           </item>

